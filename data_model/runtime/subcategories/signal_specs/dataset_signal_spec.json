  "model_version": "v2",
  "supersedes": "v1",
  "category": "Dataset",
  "current_scope": {
    "supported_upload_formats": [".csv", ".tsv", ".xlsx", ".json"],
    "supported_url_suffix_hints": [".csv", ".tsv", ".xlsx", ".xls", ".json"],
    "supported_ingesters": ["delimited_text", "xlsx_preview", "json_record_normalization"],
    "excluded_for_now": [
      ".parquet",
      ".feather",
      ".arrow",
      ".orc",
      ".geojson",
      ".shp",
      ".gpkg",
      ".nc",
      ".h5",
      ".sqlite",
      ".sav",
      ".dta",
      ".sas7bdat",
      ".isoxml"
    ],
    "notes": [
      "This scoped v2 spec is tailored to the formats the current runtime actually ingests today.",
      "Unsupported scientific, geospatial bundle, embedded-database, and statistical formats are intentionally left out of runtime scoring until native ingestion exists.",
      "The public runtime taxonomy is intentionally kept stable in this scoped v2. It does not introduce new dataset-only public labels beyond input_data, output_data, and survey_data."
    ]
  },
  "file_format_baseline_signals": {
    "_doc": "Format-level evidence that the uploaded asset is a dataset. In current scope, only formats the runtime ingests today are listed.",
    "tabular_delimited": {
      "extensions": [".csv", ".tsv"],
      "mime_types": ["text/csv", "text/tab-separated-values"],
      "dataset_confidence_bonus": 0.25
    },
    "spreadsheet": {
      "extensions": [".xlsx"],
      "mime_types": ["application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "application/vnd.ms-excel"],
      "dataset_confidence_bonus": 0.22
    },
    "structured_json_records": {
      "extensions": [".json"],
      "mime_types": ["application/json", "text/json"],
      "dataset_confidence_bonus": 0.15,
      "note": "Lower bonus than delimited/spreadsheet files because JSON is also common in non-dataset content. Requires structural confirmation."
    }
  },
  "structural_signals_universal": {
    "_doc": "Format-agnostic dataset-shape detectors intended for current-scope CSV/TSV/XLSX/JSON ingestion outputs.",
    "min_columns_for_dataset": 2,
    "min_rows_for_dataset": 2,
    "tabular_shape_bonus": 0.15,
    "indicators": {
      "header_row_detected": {
        "bonus": 0.08,
        "rule": "A column header line is present in the normalized preview."
      },
      "consistent_row_width": {
        "bonus": 0.06,
        "rule": "Preview rows suggest a stable tabular layout."
      },
      "date_column_present": {
        "bonus": 0.07,
        "patterns_any": ["date", "time", "timestamp", "datetime", "_at", "_on"]
      },
      "id_column_present": {
        "bonus": 0.08,
        "patterns_any": ["id", "_id", "uuid", "_uuid", "code", "_code", "key", "_key"]
      },
      "numeric_column_majority": {
        "bonus": 0.05,
        "rule": "The preview suggests that several columns carry short numeric values rather than prose."
      }
    },
    "anti_indicators": {
      "long_prose_columns": {
        "penalty": 0.20,
        "rule": "Very long cell-like text suggests a document or note table rather than a dataset."
      },
      "single_row_data": {
        "penalty": 0.10
      }
    }
  },
  "scoring_orchestration_notes": [
    "This scoped v2 spec is backward-compatible with the current runtime because existing runtime-used sections remain present: feature_signals, profile_mapping_overrides, synthetic_unified_subcategories, and broad_fallback_rule.",
    "file_format_baseline_signals and structural_signals_universal are currently design-aligned metadata for the next dataset-confidence pass; they should not be treated as implemented runtime behavior unless the scorer explicitly consumes them.",
    "Keep dataset subtype selection anchored in measurable signals extracted from normalized CSV/TSV/XLSX/JSON previews.",
    "Prefer stable current-scope public labels over expanding the outward taxonomy prematurely."
  ],
