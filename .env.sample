# Agri-Tag API Configuration

# Server Settings
HOST=
PORT=
WORKERS=

DOCINT_AUTH_USERS=
DOCINT_AUTH_PASSWORD=

DOCINT_LLM_BASE_URL=
DOCINT_LLM_MODEL=
DOCINT_LLM_API_KEY=

VISION_LLM_BASE_URL=
VISION_LLM_MODEL=
VISION_LLM_API_KEY=

# Optional media transcriber backend for audio and video uploads
MEDIA_TRANSCRIBER_ENABLED=false
MEDIA_TRANSCRIBER_BASE_URL=
MEDIA_TRANSCRIBER_WHISPER_MODEL=medium
MEDIA_TRANSCRIBER_MODE=auto
MEDIA_TRANSCRIBER_API_KEY=
MEDIA_TRANSCRIBER_BASIC_USER=
MEDIA_TRANSCRIBER_BASIC_PASS=

# Optional Agri Gate security screening for files and URLs
AGRI_GATE_BASE_URL=
AGRI_GATE_API_TOKEN=
AGRI_GATE_TIMEOUT=60
AGRI_GATE_URL_STRICT=true
AGRI_GATE_FILE_STRICT=true

# Optional PageSense URL extraction
URL_CONTENT_EXTRACTOR_BASE=
EXTRACTOR_TIMEOUT=150
EXTRACTOR_MIN_CHARS=100
URL_EXTRACTION_CACHE_TTL_SEC=172800
AGRICULTURE_CACHE_TTL_SEC=172800
RUNTIME_CACHE_MAX_ENTRIES=256
RUNTIME_CACHE_MAX_BYTES=67108864
TEXT_LLM_GAP_THRESHOLD=0.12
URL_TEXT_LLM_MAX_CHARS=7000
URL_DATASET_LLM_MAX_CHARS=6000

# Media upload caps for synchronous classification
MAX_AUDIO_DURATION_SEC=3000
MAX_VIDEO_DURATION_SEC=3000
MAX_AUDIO_UPLOAD_SIZE_MB=768
MAX_VIDEO_UPLOAD_SIZE_MB=1024
MAX_OTHER_UPLOAD_SIZE_MB=50
MAX_REQUEST_BODY_MB=1024
MAX_DOCUMENT_UNITS=100

# Tabular ingestion preview caps
TABULAR_MAX_ROWS=100
TABULAR_PREVIEW_ROWS=30
XLSX_MAX_SHEETS=10
XLSX_MAX_ROWS_PER_SHEET=25

# Agriculture relevance pipeline
# Stage 1 (lexicon) is always on.
# Stage 2 defaults to a CPU-friendly multilingual E5 model when dependencies are installed.
AGRI_ENABLE_EMBEDDING=true
AGRI_EMBEDDING_MODEL=intfloat/multilingual-e5-small
AGRI_EMBEDDING_TEXT_LIMIT=3500
AGRI_EMBEDDING_OVERRIDE_THRESHOLD=0.74
AGRI_EMBEDDING_BLEND_WEIGHT=0.45

# Stage 3 (LLM fallback) is only used for ambiguous cases.
AGRI_ENABLE_LLM_FALLBACK=true

# TESSDATA_PREFIX=/usr/share/tesseract-ocr/4.00/tessdata
