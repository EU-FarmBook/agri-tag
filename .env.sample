# Agri-Tag API Configuration

# Server Settings
HOST=
PORT=
WORKERS=

DOCINT_AUTH_USERS=
DOCINT_AUTH_PASSWORD=

DOCINT_LLM_BASE_URL=
DOCINT_LLM_MODEL=
DOCINT_LLM_API_KEY=

VISION_LLM_BASE_URL=
VISION_LLM_MODEL=
VISION_LLM_API_KEY=
# Raster DPI for PDF page-to-image rendering sent to the vision model.
# 150-200 is the practical sweet spot for VLM document understanding.
VISION_RENDER_DPI=150

# --- Mistral AI provider (optional) -----------------------------------------
# When a request to /classify (or /classify-url, /classify-media-llm) sets
# provider=mistral, text+vision classification is routed to Mistral's
# OpenAI-compatible endpoint, and OCR/transcription use the native Mistral SDK.
# Only MISTRAL_API_KEY is required; the rest have sensible defaults.
MISTRAL_API_KEY=
# OpenAI-compatible chat endpoint used for text + vision classification.
MISTRAL_OPENAI_BASE_URL=https://api.mistral.ai/v1
# Text classifier: small is the accuracy-per-euro sweet spot for this task.
MISTRAL_TEXT_MODEL=mistral-small-latest
# Vision classifier for document pages/images (step up to pixtral-large for hard visual cases).
MISTRAL_VISION_MODEL=mistral-medium-latest
# OCR model for scanned PDFs/images (native Mistral SDK).
MISTRAL_OCR_MODEL=mistral-ocr-latest
# Voxtral model for audio/video transcription (native Mistral SDK).
MISTRAL_AUDIO_MODEL=voxtral-mini-latest
# Optional: override the native SDK server URL (OCR / transcription); leave empty for default.
MISTRAL_SERVER_URL=

# Optional media transcriber backend for audio and video uploads
MEDIA_TRANSCRIBER_ENABLED=false
MEDIA_TRANSCRIBER_BASE_URL=
MEDIA_TRANSCRIBER_WHISPER_MODEL=medium
MEDIA_TRANSCRIBER_MODE=auto
MEDIA_TRANSCRIBER_API_KEY=
MEDIA_TRANSCRIBER_BASIC_USER=
MEDIA_TRANSCRIBER_BASIC_PASS=

# Optional Agri Gate security screening for files and URLs
AGRI_GATE_BASE_URL=
AGRI_GATE_API_TOKEN=
AGRI_GATE_TIMEOUT=60
AGRI_GATE_URL_STRICT=true
AGRI_GATE_FILE_STRICT=true

# Optional PageSense URL extraction
URL_CONTENT_EXTRACTOR_BASE=
EXTRACTOR_TIMEOUT=150
EXTRACTOR_MIN_CHARS=100
URL_EXTRACTION_CACHE_TTL_SEC=172800
AGRICULTURE_CACHE_TTL_SEC=172800
RUNTIME_CACHE_MAX_ENTRIES=256
RUNTIME_CACHE_MAX_BYTES=67108864
TEXT_LLM_GAP_THRESHOLD=0.12
URL_TEXT_LLM_MAX_CHARS=7000
URL_DATASET_LLM_MAX_CHARS=6000

# Media upload caps for synchronous classification
MAX_AUDIO_DURATION_SEC=3000
MAX_VIDEO_DURATION_SEC=3000
MAX_AUDIO_UPLOAD_SIZE_MB=768
MAX_VIDEO_UPLOAD_SIZE_MB=1024
MAX_OTHER_UPLOAD_SIZE_MB=50
MAX_REQUEST_BODY_MB=1024
MAX_DOCUMENT_UNITS=100
# Cap for the /classify-text raw-text endpoint (~10 A4 pages)
MAX_TEXT_INPUT_WORDS=5000

# Tabular ingestion preview caps
TABULAR_MAX_ROWS=100
TABULAR_PREVIEW_ROWS=30
XLSX_MAX_SHEETS=10
XLSX_MAX_ROWS_PER_SHEET=25

# Agriculture relevance pipeline
# Stage 1 (lexicon) is always on.
# Stage 2 defaults to a CPU-friendly multilingual E5 model when dependencies are installed.
AGRI_ENABLE_EMBEDDING=true
AGRI_EMBEDDING_MODEL=intfloat/multilingual-e5-small
AGRI_EMBEDDING_TEXT_LIMIT=3500
AGRI_EMBEDDING_OVERRIDE_THRESHOLD=0.74
AGRI_EMBEDDING_BLEND_WEIGHT=0.45

# Stage 3 (LLM fallback) is only used for ambiguous cases.
AGRI_ENABLE_LLM_FALLBACK=true

# --- Intended purpose (user-intent) inference -------------------------------
# Multi-label, capped at 3. LLM-primary (rides the configured text LLM, gated by
# use_text_llm + agriculture relevance) with an always-on embedding fallback.
# Turn the always-on embedding stage on/off.
PURPOSE_ENABLE_EMBEDDING=true
# CPU multilingual embedding model used to score the document against purpose anchors.
PURPOSE_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Max intended purposes returned per asset (at least 1, at most this).
PURPOSE_MAX_SELECTED=3
# Embedding score a purpose must clear to be emitted (the top one is always kept).
PURPOSE_SELECT_THRESHOLD=0.5
# Max characters of document text sent to the LLM purpose classifier.
PURPOSE_LLM_MAX_CHARS=9000

# --- Output cardinality -----------------------------------------------------
# Max topics returned per asset (at least 1, at most this).
TOPIC_MAX_SELECTED=3
# Max subcategory candidates surfaced: always the best, plus a close runner-up.
SUBCATEGORY_MAX_CANDIDATES=2
# Show the 2nd subcategory only when its probability is within this gap of the best.
SUBCATEGORY_SECOND_GAP=0.15

# EXPERIMENTAL: for ambiguous-agriculture documents, merge the Stage-3 agriculture
# LLM call and the document subtype LLM call into ONE call (saves a round-trip).
# Off by default; validate agriculture-gate accuracy on an eval set before enabling.
MERGE_AGRI_SUBCATEGORY_LLM=false

# TESSDATA_PREFIX=/usr/share/tesseract-ocr/4.00/tessdata
